/*
 * OligoGym benchmark calibration — Nextflow config for AWS Batch via Seqera.
 *
 * The image is a pre-built multi-layer image in GHCR (public), NOT a Wave-built
 * conda spec. Rationale in image_build_spec.md: the 1.2 GB RNA-FM checkpoint has
 * to be baked in, and Wave's conda path builds from a package spec and cannot
 * COPY an arbitrary large binary into the layer stack.
 *
 * Wave stays ENABLED anyway: with Fusion v2 it augments the image for direct S3
 * access from the task filesystem, which is what makes the 45,950-fold-fit
 * Phase-3 sweep practical. Wave augmentation of an existing image is orthogonal
 * to Wave *building* one from a conda spec.
 */

plugins {
    id 'nf-amazon'
}

params {
    image = 'ghcr.io/stevenfroelichbmrn/oligogym-bench:latest'
}

process {
    container = params.image
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143, 247] ? 'retry' : 'ignore' }
    maxRetries = 3

    // ---- CPU measurement tasks (c6id/r6id/m6id) --------------------------
    // 1 vCPU per fold-fit: the harness is single-config, and packing many
    // single-threaded fits per instance is what makes the CPU arm cheap.
    // Memory is set from the MEASURED peak RSS per size tier (see cost_model.csv);
    // 4 GB covers every measured cpu-class config except sherwood.
    // MEASURED memory ladder. Exit 137 (OOM) was observed at 8 GB for
    // RandomForest n_estimators>=500 on sherwood (291,551 rows) and for
    // RNAFMEmbeddings on >=2,431 rows, so the ladder climbs steeply on retry.
    withLabel: measure_cpu {
        cpus   = 2
        memory = { task.attempt == 1 ? 8.GB : (task.attempt == 2 ? 32.GB : 120.GB) }
        time   = '8h'
    }

    // One GPU per measurement task: peak VRAM and epochs-to-early-stop are only
    // meaningful if nothing else shares the device.
    withLabel: measure_gpu {
        accelerator = 1
        cpus   = 4
        memory = { task.attempt > 1 ? 28.GB : 14.GB }
        time   = '8h'
    }

    // ---- GPU packing sweep ------------------------------------------------
    // Must own the whole instance: the measurement IS contention, so nothing
    // else may share the GPU or the vCPUs.
    withLabel: gpu_pack {
        accelerator = 1
        cpus   = 4      // g4dn.xlarge = 4 vCPU + 1 T4
        memory = 14.GB
        time   = '8h'
    }

    withLabel: validate_gpu {
        accelerator = 1
        cpus   = 4
        memory = 14.GB
        time   = '2h'
    }

    withLabel: validate_cpu {
        cpus   = 2
        memory = 8.GB
        time   = '2h'
    }

    withLabel: tiny {
        cpus   = 1
        memory = 2.GB
        time   = '1h'
    }
}

profiles {

    // CPU-class Batch env: bath-env-ondemand-2000cpu (c6id/r6id/m6id, nvme on)
    batch_cpu {
        process.executor = 'awsbatch'
        process.queue    = 'TowerForge-6snAfKmF865VkTzUiySSin'
        aws.region       = 'us-west-2'
        aws.batch.maxParallelTransfers = 8
        aws.batch.maxSpotAttempts = 0
        wave.enabled     = true
        fusion.enabled   = true
        fusion.exportStorageCredentials = true
    }

    // GPU Batch env: batch-gpu (g4dn family, gpuEnabled)
    batch_gpu {
        process.executor = 'awsbatch'
        process.queue    = 'TowerForge-fJ1Tu2lZEwf2cSF54nm2v'
        aws.region       = 'us-west-2'
        aws.batch.maxParallelTransfers = 8
        aws.batch.maxSpotAttempts = 0
        wave.enabled     = true
        fusion.enabled   = true
        fusion.exportStorageCredentials = true
        // The ECS GPU-optimized AMI supplies the NVIDIA runtime; no imageId pin
        // is set on the compute env, so it is inherited.
        docker.runOptions = '--gpus all'
    }

    local {
        process.executor = 'local'
        docker.enabled   = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
}

// Full provenance for every measured task: this is the raw material for the
// cost model, so per-task cpu/mem/time must be recorded.
timeline { enabled = true; overwrite = true; file = "${params.outdir}/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/report.html" }
trace {
    enabled = true
    overwrite = true
    file = "${params.outdir}/trace.txt"
    fields = 'task_id,hash,name,tag,status,exit,attempt,submit,start,complete,duration,realtime,%cpu,%mem,peak_rss,peak_vmem,rchar,wchar,cpus,memory,disk,container'
}
dag { enabled = false }
